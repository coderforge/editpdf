{
  "name": "@editpdf/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "editpdf web interface: drag and drop PDF merge, split and rotate.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../openapi/editpdf-v1.yaml -o src/api/schema.gen.ts",
    "dev": "vite",
    "typecheck": "npm run generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run generate && tsc -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
